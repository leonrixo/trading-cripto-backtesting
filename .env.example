# Archivo de configuración de ejemplo para Binance Testnet (Sandbox)
# Para obtener llaves gratuitas con saldo ficticio oficial de Binance:
# 1. Visita https://testnet.binance.vision/ con tu cuenta de GitHub
# 2. Genera una API Key y Secret Key
# 3. Renombra este archivo a .env y pega tus valores abajo:

BINANCE_TESTNET_API_KEY=tu_api_key_aqui
BINANCE_TESTNET_SECRET=tu_secret_key_aqui

